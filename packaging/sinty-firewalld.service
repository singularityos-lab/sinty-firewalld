[Unit]
Description=Sinty firewall daemon
Documentation=https://github.com/singularityos-lab/sinty-firewalld
Wants=dbus.service
After=dbus.service
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=simple
ExecStartPre=-/bin/mkdir -p /var/lib/sinty-firewalld
ExecStart=/usr/libexec/sinty-firewalld
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target graphical.target
